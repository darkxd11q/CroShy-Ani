<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Admin Panel — CroShy Anı</title>
<link rel="icon" type="image/png" sizes="32x32" href="/img/logo-64.png" />
<link rel="apple-touch-icon" href="/img/logo-192.png" />
<script>(function(){var m=document.cookie.match(/(?:^|; )croshy_theme=([^;]+)/);if(m&&/^[a-z]+$/.test(m[1]))document.documentElement.classList.add('theme-'+m[1]);})();</script>
<link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <div class="bg-blobs">
    <div class="blob b1"></div>
    <div class="blob b2"></div>
  </div>

  <header class="site">
    <a href="/" class="brand"><span class="brand-mark-wrap"><img src="/img/logo-192.png" alt="CroShy Anı logosu" /></span><span class="brand-text">CroShy Anı</span> <span style="color:var(--text-dim); font-weight:500; font-size:0.85rem; margin-left:2px;">· Admin</span></a>
    <nav class="site-nav">
      <div class="social-dropdown" id="socialDropdown">
        <button type="button" class="yt-link social-trigger" aria-label="Bağlantılar" aria-haspopup="true" aria-expanded="false">
          <svg viewBox="0 0 24 24" width="19" height="19" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M9.5 14.5 14.5 9.5" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M11 6.5 12.7 4.8a3.2 3.2 0 0 1 4.5 4.5L15.5 11" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M13 17.5 11.3 19.2a3.2 3.2 0 0 1-4.5-4.5L8.5 13" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="social-menu">
          <a href="https://youtube.com/CroShy" target="_blank" rel="noopener" class="social-menu-item">
            <svg class="social-icon" viewBox="0 0 28 28" xmlns="http://www.w3.org/2000/svg">
              <rect width="28" height="28" rx="7" fill="#FF0000"/>
              <path d="M11.5 9.4L19.6 14L11.5 18.6V9.4Z" fill="white"/>
            </svg>
            YouTube
          </a>
          <a href="https://discord.gg/Vp8JcCynZF" target="_blank" rel="noopener" class="social-menu-item">
            <img class="social-icon" src="/img/social-discord.png" alt="" />
            Discord
          </a>
          <a href="https://kick.com/croshy" target="_blank" rel="noopener" class="social-menu-item">
            <img class="social-icon" src="/img/social-kick.png" alt="" />
            Kick
          </a>
          <a href="https://twitch.tv/croshyy" target="_blank" rel="noopener" class="social-menu-item">
            <img class="social-icon" src="/img/social-twitch.png" alt="" />
            Twitch
          </a>
          <a href="https://bynogame.com/destekle/croshy" target="_blank" rel="noopener" class="social-menu-item">
            <img class="social-icon wordmark" src="/img/social-bynogame.png" alt="" />
            Bağış Yap
          </a>
        </div>
      </div>
      <a href="/" class="btn ghost">Siteyi Gör</a>
      <form method="POST" action="/admin/logout">
        <button type="submit" class="btn small">Çıkış Yap</button>
      </form>
    </nav>
  </header>

  <div class="admin-wrap">
    <div class="admin-topbar">
      <div>
        <h2 style="margin:0;">Onay Bekleyenler</h2>
        <div class="admin-stat">
          Hoşgeldin, <%= username %>
          <span style="color:var(--accent-3);">(<%= adminRole === 'superadmin' ? 'Süper Admin' : 'Moderatör' %>)</span>
          · <%= pending.length %> bekleyen · <%= approvedCount %> onaylı anı yayında
        </div>
      </div>
    </div>

    <div class="pending-list" id="pending-list">
      <% if (pending.length === 0) { %>
        <div class="empty-state">Şu an onay bekleyen anı yok 🎉</div>
      <% } %>

      <% pending.forEach(function(item) { %>
        <div class="pending-item" data-id="<%= item.id %>">
          <div class="thumb"
               data-url="<%= item.url %>"
               data-type="<%= item.type %>"
               data-name="<%= item.uploaderName %>"
               data-caption="<%= item.caption %>">
            <% if (item.type === 'video') { %>
              <video src="<%= item.url %>" muted loop autoplay playsinline></video>
              <div class="play-icon" style="width:40px;height:40px;font-size:1rem;">▶</div>
            <% } else { %>
              <img src="<%= item.url %>" alt="" />
            <% } %>
          </div>
          <div class="info">
            <div class="name"><%= item.uploaderName %> <span style="color:var(--text-dim); font-weight:400;">— <%= item.type === 'video' ? 'video' : 'fotoğraf' %></span></div>
            <% if (item.caption) { %><div class="caption"><%= item.caption %></div><% } %>
            <div class="date">
              <%= new Date(item.createdAt).toLocaleString('tr-TR') %>
              <% if (adminRole === 'superadmin') { %> · IP: <%= item.ip || 'bilinmiyor' %><% } %>
            </div>
          </div>
          <div class="actions">
            <button class="btn approve small" data-action="approve" data-id="<%= item.id %>">✓ Onayla</button>
            <button class="btn danger small" data-action="reject" data-id="<%= item.id %>">✕ Reddet</button>
            <button class="btn danger small" data-action="ban" data-id="<%= item.id %>" title="Bu hesabı yasakla ve bekleyen tüm gönderilerini sil">🚫 Hesabı Yasakla</button>
          </div>
        </div>
      <% }) %>
    </div>

    <% if (adminRole === 'superadmin') { %>
    <div class="admin-topbar" style="margin-top: 48px;">
      <div>
        <h2 style="margin:0;">Onaylı Anılar</h2>
        <div class="admin-stat"><%= approvedItems.length %> anı yayında — gerekirse buradan kaldırabilirsin</div>
      </div>
    </div>

    <div class="profile-grid" id="approved-list" style="margin-bottom: 20px;">
      <% if (approvedItems.length === 0) { %>
        <div class="empty-state">Henüz onaylı bir anı yok</div>
      <% } %>
      <% approvedItems.forEach(function(item) { %>
        <div class="profile-item-card" data-id-row="<%= item.id %>">
          <% if (item.type === 'video') { %>
            <video src="<%= item.url %>" muted loop autoplay playsinline></video>
          <% } else { %>
            <img src="<%= item.url %>" alt="" />
          <% } %>
          <span class="profile-item-status is-approved"><%= item.uploaderName %></span>
          <span class="profile-item-likes">❤️ <%= item.likes %></span>
          <button type="button" class="profile-item-delete" data-action="delete-approved" data-id="<%= item.id %>" aria-label="Sil" title="Bu anıyı kaldır">✕</button>
        </div>
      <% }) %>
    </div>

    <div class="admin-topbar" style="margin-top: 48px;">
      <div>
        <h2 style="margin:0;">Son Silinenler</h2>
        <div class="admin-stat"><%= deletedItems.length %> anı silinmiş — 24 saat içinde geri alabilirsin, sonra kalıcı olarak kaldırılır</div>
      </div>
    </div>

    <div class="pending-list" id="deleted-list">
      <% if (deletedItems.length === 0) { %>
        <div class="empty-state">Silinmiş bir anı yok</div>
      <% } %>
      <% deletedItems.forEach(function(item) { %>
        <% var msLeft = (item.deletedAt + deleteRetentionMs) - Date.now(); %>
        <% var hoursLeft = Math.max(0, Math.ceil(msLeft / (60*60*1000))); %>
        <div class="pending-item" data-id-row="<%= item.id %>" style="align-items:center;">
          <div class="thumb"
               data-url="<%= item.url %>"
               data-type="<%= item.type %>"
               data-name="<%= item.uploaderName %>"
               data-caption="<%= item.caption %>">
            <% if (item.type === 'video') { %>
              <video src="<%= item.url %>" muted loop autoplay playsinline></video>
            <% } else { %>
              <img src="<%= item.url %>" alt="" />
            <% } %>
          </div>
          <div class="info">
            <div class="name"><%= item.uploaderName %> <span style="color:var(--text-dim); font-weight:400;">— <%= item.type === 'video' ? 'video' : 'fotoğraf' %></span></div>
            <% if (item.caption) { %><div class="caption"><%= item.caption %></div><% } %>
            <div class="date">
              Silindi: <%= new Date(item.deletedAt).toLocaleString('tr-TR') %>
              · <%= hoursLeft %> saat sonra kalıcı olarak silinecek
            </div>
          </div>
          <div class="actions">
            <button class="btn approve small" data-action="restore" data-id="<%= item.id %>">↩ Geri Al</button>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="admin-topbar" style="margin-top: 48px;">
      <div>
        <h2 style="margin:0;">Yasaklı IP'ler</h2>
        <div class="admin-stat"><%= bans.length %> IP adresi yasaklı — anı gönderemez (görüntüleme etkilenmez)</div>
      </div>
    </div>

    <div class="pending-list" id="ban-list">
      <% if (bans.length === 0) { %>
        <div class="empty-state">Şu an yasaklı IP yok</div>
      <% } %>
      <% bans.forEach(function(b) { %>
        <div class="pending-item" data-ip-row="<%= b.ip %>" style="align-items:center;">
          <div class="info">
            <div class="name">
              IP: <%= b.ip %>
              <span style="color:var(--text-dim); font-weight:400;">
                — hesap: <%= (b.usernames && b.usernames.length) ? b.usernames.join(', ') : 'bilinmiyor' %>
              </span>
            </div>
            <div class="date">Yasaklandı: <%= new Date(b.bannedAt).toLocaleString('tr-TR') %></div>
          </div>
          <div class="actions">
            <button class="btn approve small" data-action="unban" data-ip="<%= b.ip %>">Yasağı Kaldır</button>
          </div>
        </div>
      <% }) %>
    </div>
    <div class="admin-topbar" style="margin-top: 48px;">
      <div>
        <h2 style="margin:0;">Genel Ayarlar</h2>
        <div class="admin-stat">Kullanıcıya özel bir limit yoksa herkes için geçerli olan varsayılan değerler</div>
      </div>
    </div>

    <div class="upload-card" style="margin-bottom: 20px;">
      <form id="settings-form" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 14px; align-items:end;">
        <div class="field" style="margin:0;">
          <label for="dailySubmitLimit">Günlük gönderim limiti (adet)</label>
          <input type="number" id="dailySubmitLimit" min="1" step="1" value="<%= settings.dailySubmitLimit %>"
                 style="width:100%; background: rgba(255,255,255,0.04); border:1px solid var(--card-border); border-radius:12px; padding:12px 14px; color: var(--text); font-family: var(--font-body); font-size:0.95rem;" />
        </div>
        <div class="field" style="margin:0;">
          <label for="maxImageMb">Varsayılan fotoğraf sınırı (MB)</label>
          <input type="number" id="maxImageMb" min="0.1" step="0.1" value="<%= (settings.maxImageBytes / (1024*1024)).toFixed(1) %>"
                 style="width:100%; background: rgba(255,255,255,0.04); border:1px solid var(--card-border); border-radius:12px; padding:12px 14px; color: var(--text); font-family: var(--font-body); font-size:0.95rem;" />
        </div>
        <div class="field" style="margin:0;">
          <label for="maxVideoMb">Varsayılan video sınırı (MB)</label>
          <input type="number" id="maxVideoMb" min="0.1" step="0.1" value="<%= (settings.maxVideoBytes / (1024*1024)).toFixed(1) %>"
                 style="width:100%; background: rgba(255,255,255,0.04); border:1px solid var(--card-border); border-radius:12px; padding:12px 14px; color: var(--text); font-family: var(--font-body); font-size:0.95rem;" />
        </div>
        <div class="field" style="margin:0;">
          <label for="maxVideoDurationSec">Varsayılan video süresi (saniye)</label>
          <input type="number" id="maxVideoDurationSec" min="1" step="1" value="<%= settings.maxVideoDurationSec %>"
                 style="width:100%; background: rgba(255,255,255,0.04); border:1px solid var(--card-border); border-radius:12px; padding:12px 14px; color: var(--text); font-family: var(--font-body); font-size:0.95rem;" />
        </div>
        <button type="submit" class="btn primary" style="height:44px;">Kaydet</button>
      </form>
      <div class="status-msg" id="settingsStatus"></div>
    </div>

    <div class="admin-topbar" style="margin-top: 48px;">
      <div>
        <h2 style="margin:0;">Kullanıcıya Özel Limitler</h2>
        <div class="admin-stat">Bir kullanıcı adı gir, istediğin alanları doldur — boş bıraktığın alan genel ayara döner</div>
      </div>
    </div>

    <div class="upload-card" style="margin-bottom: 8px;">
      <form id="user-limits-form" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; align-items:end;">
        <div class="field" style="margin:0;">
          <label for="limitUsername">Kullanıcı adı</label>
          <input type="text" id="limitUsername" placeholder="Kullanıcı adı" maxlength="10" required
                 style="width:100%; background: rgba(255,255,255,0.04); border:1px solid var(--card-border); border-radius:12px; padding:12px 14px; color: var(--text); font-family: var(--font-body); font-size:0.95rem;" />
        </div>
        <div class="field" style="margin:0;">
          <label for="limitImageMb">Fotoğraf sınırı (MB)</label>
          <input type="number" id="limitImageMb" min="0.1" step="0.1" placeholder="boş = varsayılan"
                 style="width:100%; background: rgba(255,255,255,0.04); border:1px solid var(--card-border); border-radius:12px; padding:12px 14px; color: var(--text); font-family: var(--font-body); font-size:0.95rem;" />
        </div>
        <div class="field" style="margin:0;">
          <label for="limitVideoMb">Video sınırı (MB)</label>
          <input type="number" id="limitVideoMb" min="0.1" step="0.1" placeholder="boş = varsayılan"
                 style="width:100%; background: rgba(255,255,255,0.04); border:1px solid var(--card-border); border-radius:12px; padding:12px 14px; color: var(--text); font-family: var(--font-body); font-size:0.95rem;" />
        </div>
        <div class="field" style="margin:0;">
          <label for="limitVideoDurationSec">Video süresi (saniye)</label>
          <input type="number" id="limitVideoDurationSec" min="1" step="1" placeholder="boş = varsayılan"
                 style="width:100%; background: rgba(255,255,255,0.04); border:1px solid var(--card-border); border-radius:12px; padding:12px 14px; color: var(--text); font-family: var(--font-body); font-size:0.95rem;" />
        </div>
        <button type="submit" class="btn primary" style="height:44px;">Uygula</button>
      </form>
      <div class="status-msg" id="userLimitsStatus"></div>
    </div>

    <div class="pending-list" id="limits-list">
      <% if (customLimitUsers.length === 0) { %>
        <div class="empty-state">Şu an özel limiti olan bir kullanıcı yok</div>
      <% } %>
      <% customLimitUsers.forEach(function(u) { %>
        <div class="pending-item" data-username-row="<%= u.username %>" style="align-items:center;">
          <div class="info">
            <div class="name"><%= u.username %></div>
            <div class="date">
              <% if (u.customImageBytes) { %>📷 <%= (u.customImageBytes/(1024*1024)).toFixed(1) %>MB &nbsp;<% } %>
              <% if (u.customVideoBytes) { %>🎬 <%= (u.customVideoBytes/(1024*1024)).toFixed(1) %>MB &nbsp;<% } %>
              <% if (u.customVideoDurationSec) { %>⏱️ <%= u.customVideoDurationSec %>sn<% } %>
            </div>
          </div>
          <div class="actions">
            <button class="btn danger small" data-action="reset-limits" data-username="<%= u.username %>">Sıfırla</button>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="admin-topbar" style="margin-top: 48px;">
      <div>
        <h2 style="margin:0;">Geri Bildirimler</h2>
        <div class="admin-stat"><%= feedbackList.filter(function(f){ return f.status === 'pending'; }).length %> bekleyen · Onaylarsan kullanıcı ilk girişinde teşekkür ekranı görür; "Çok Beğendim" ise daha samimi bir teşekkür + 🤝 Destekçi rozeti (+1 günlük hak) verir</div>
      </div>
    </div>

    <div class="pending-list" id="feedback-list">
      <% if (feedbackList.length === 0) { %>
        <div class="empty-state">Henüz geri bildirim yok</div>
      <% } %>
      <% feedbackList.forEach(function(f) {
           var labels = { pending: 'Bekliyor', approved: 'Onaylandı', loved: 'Çok beğenildi', dismissed: 'Geçildi' }; %>
        <div class="pending-item" data-fb-id="<%= f.id %>" style="align-items:flex-start;">
          <div class="info">
            <div class="name"><%= f.username %> <span class="code-status <%= f.status === 'pending' ? 'active' : (f.status === 'dismissed' ? 'expired' : 'used') %>"><%= labels[f.status] || f.status %></span></div>
            <div class="caption" style="white-space:pre-wrap; overflow-wrap:anywhere; color:var(--text);"><%= f.message %></div>
            <div class="date"><%= new Date(f.createdAt).toLocaleString('tr-TR') %></div>
          </div>
          <div class="actions" style="flex-wrap:wrap;">
            <% if (f.status !== 'dismissed') { %>
              <% if (f.status === 'pending') { %><button class="btn approve small" data-fb-action="approve" data-id="<%= f.id %>">✓ Onayla</button><% } %>
              <% if (f.status !== 'loved') { %><button class="btn small" data-fb-action="love" data-id="<%= f.id %>">💜 Çok Beğendim</button><% } %>
              <% if (f.status === 'pending') { %><button class="btn danger small" data-fb-action="dismiss" data-id="<%= f.id %>">Geç</button><% } %>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="admin-topbar" style="margin-top: 48px;">
      <div>
        <h2 style="margin:0;">Yasaklı Hesaplar</h2>
        <div class="admin-stat"><%= bannedUsers.length %> hesap yasaklı — anı gönderemez, beğenemez (siteyi görüntüleyebilir)</div>
      </div>
    </div>
    <div class="pending-list" id="banned-users-list">
      <% if (bannedUsers.length === 0) { %><div class="empty-state">Yasaklı hesap yok</div><% } %>
      <% bannedUsers.forEach(function(u) { %>
        <div class="pending-item" style="align-items:center;">
          <div class="info">
            <div class="name"><%= u.username %></div>
            <div class="date"><%= u.bannedReason || 'Neden belirtilmemiş' %></div>
          </div>
          <div class="actions"><button class="btn approve small" data-unban-user="<%= u.username %>">Yasağı Kaldır</button></div>
        </div>
      <% }) %>
    </div>

    <div class="admin-topbar" style="margin-top: 48px;">
      <div>
        <h2 style="margin:0;">Hesap Yönetimi</h2>
        <div class="admin-stat">Kullanıcı adı ara — adını değiştir ya da hesabı sil</div>
      </div>
    </div>
    <div class="upload-card" style="margin-bottom: 20px;">
      <input type="text" id="userSearch" placeholder="Kullanıcı adı ara…" maxlength="20" autocomplete="off"
             style="width:100%; background: rgba(255,255,255,0.04); border:1px solid var(--card-border); border-radius:12px; padding:12px 14px; color: var(--text); font-family: var(--font-body); font-size:0.95rem;" />
      <div class="pending-list" id="user-results" style="margin-top:14px;"></div>
    </div>

    <div class="admin-topbar" style="margin-top: 48px;">
      <div>
        <h2 style="margin:0;">Rozet Kodları</h2>
        <div class="admin-stat">Tek kullanımlık, 1 gün geçerli kodlarla 💜 ÖZEL ya da 💠 Plus rolü ver</div>
      </div>
    </div>

    <div class="codegen-card glow-special" id="codegenCard">
      <div class="codegen-roles">
        <button type="button" class="role-chip role-special active" data-badge="special">💜 ÖZEL</button>
        <button type="button" class="role-chip role-plus" data-badge="plus">💠 Plus</button>
      </div>
      <div class="code-display" id="codeDisplay"><span class="code-placeholder">DARK-1907-••••••••</span></div>
      <div class="code-meta" id="codeMeta">Bir rol seç ve kod oluştur</div>
      <div class="codegen-actions">
        <select id="codeDays" class="code-days" aria-label="Rozet süresi"><option value="0">Süresiz</option><option value="7">7 gün</option><option value="30" selected>30 gün</option><option value="90">90 gün</option></select>
        <button type="button" class="btn primary" id="generateCodeBtn">✨ Kod Oluştur</button>
        <button type="button" class="btn" id="copyCodeBtn" style="display:none;">📋 Kopyala</button>
      </div>
    </div>

    <div class="pending-list" id="codes-list">
      <% if (redeemCodeList.length === 0) { %>
        <div class="empty-state">Henüz kod oluşturulmadı</div>
      <% } %>
      <% redeemCodeList.forEach(function(c) {
           var state = c.redeemedBy ? 'used' : (c.expiresAt < Date.now() ? 'expired' : 'active');
           var info = BADGE_INFO[c.badge] || { label: c.badge, icon: '', className: '' }; %>
        <div class="pending-item" style="align-items:center;">
          <div class="info">
            <div class="name badge-holder-row">
              <span class="code-mono"><%= c.code %></span>
              \1
              <span class="code-status active"><%= c.durationDays ? c.durationDays + ' gün' : 'süresiz' %></span>
              <span class="code-status <%= state %>"><%= state === 'used' ? 'Kullanıldı' : (state === 'expired' ? 'Süresi doldu' : 'Aktif') %></span>
            </div>
            <div class="date">
              Oluşturuldu: <%= new Date(c.createdAt).toLocaleString('tr-TR') %>
              <% if (state === 'used') { %> · <%= c.redeemedBy %> kullandı<% } else if (state === 'active') { %> · <%= Math.max(0, Math.ceil((c.expiresAt - Date.now()) / 3600000)) %> saat geçerli<% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="admin-topbar" style="margin-top: 48px;">
      <div>
        <h2 style="margin:0;">Rozetler</h2>
        <div class="admin-stat">
          🏆 Site Kurucusu ve ❤️ CroShy rozeti sahibini <strong>tüm sınırlardan</strong> muaf tutar
        </div>
      </div>
    </div>

    <div class="upload-card" style="margin-bottom: 8px;">
      <form id="badge-form" style="display:grid; grid-template-columns: 1.4fr 1.4fr auto; gap:12px; align-items:end;">
        <div class="field" style="margin:0;">
          <label for="badgeUsername">Kullanıcı adı</label>
          <input type="text" id="badgeUsername" placeholder="Kullanıcı adı" maxlength="10" required
                 style="width:100%; background: rgba(255,255,255,0.04); border:1px solid var(--card-border); border-radius:12px; padding:12px 14px; color: var(--text); font-family: var(--font-body); font-size:0.95rem;" />
        </div>
        <div class="field" style="margin:0;">
          <label for="badgeType">Rozet</label>
          <select id="badgeType" style="width:100%; background: rgba(255,255,255,0.04); border:1px solid var(--card-border); border-radius:12px; padding:12px 14px; color: var(--text); font-family: var(--font-body); font-size:0.95rem;">
            <% BADGE_ORDER.forEach(function(code) { %>
              <option value="<%= code %>"><%= BADGE_INFO[code].icon %> <%= BADGE_INFO[code].label %></option>
            <% }) %>
          </select>
        </div>
        <button type="submit" class="btn primary" style="height:44px;">Rozet Ver</button>
      </form>
      <div class="status-msg" id="badgeStatus"></div>
    </div>

    <div class="pending-list" id="badges-list">
      <% if (badgeUsers.length === 0) { %>
        <div class="empty-state">Şu an rozeti olan bir kullanıcı yok</div>
      <% } %>
      <% badgeUsers.forEach(function(u) { %>
        <div class="pending-item" data-username-row="<%= u.username %>" style="align-items:center;">
          <div class="info">
            <div class="name badge-holder-row">
              <%= u.username %>
              <% BADGE_ORDER.forEach(function(code) { %>
                <% if (u.badges.includes(code)) { %>
                  <span class="badge-pill <%= BADGE_INFO[code].className %>">
                    <%= BADGE_INFO[code].icon %> <%= BADGE_INFO[code].label %>
                    <button type="button" data-action="revoke-badge" data-username="<%= u.username %>" data-badge="<%= code %>"
                            style="background:none; border:none; color:inherit; cursor:pointer; font-weight:700; padding:0 0 0 3px; font-size:0.85rem; line-height:1;">✕</button>
                  </span>
                <% } %>
              <% }) %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="admin-topbar" style="margin-top: 40px;">
      <div>
        <h2 style="margin:0;">Bu Haftanın Öne Çıkanları</h2>
        <div class="admin-stat">Son dağıtımdan bu yana — Haftalık rozetler her Cuma 17:15'te otomatik verilir (istersen elle de verebilirsin)</div>
      </div>
    </div>
    <div class="leaderboard-grid" style="margin-bottom: 20px;">
      <div class="upload-card" style="margin:0;">
        <h3 style="margin:0 0 12px; font-size:0.95rem;">🔥 En Çok Anı Gönderen</h3>
        <% if (weeklyLeaderboard.topSubmitters.length === 0) { %>
          <div class="empty-state">Bu hafta henüz gönderim yok</div>
        <% } else { %>
          <ol class="leaderboard-list">
            <% weeklyLeaderboard.topSubmitters.forEach(function(row) { %>
              <li><span class="lb-name"><%= row.username %></span><span class="lb-count"><%= row.count %> anı</span></li>
            <% }) %>
          </ol>
        <% } %>
      </div>
      <div class="upload-card" style="margin:0;">
        <h3 style="margin:0 0 12px; font-size:0.95rem;">⭐ En Çok Beğeni Toplayan</h3>
        <% if (weeklyLeaderboard.topLiked.length === 0) { %>
          <div class="empty-state">Bu hafta henüz beğeni yok</div>
        <% } else { %>
          <ol class="leaderboard-list">
            <% weeklyLeaderboard.topLiked.forEach(function(row) { %>
              <li><span class="lb-name"><%= row.username %></span><span class="lb-count"><%= row.count %> beğeni</span></li>
            <% }) %>
          </ol>
        <% } %>
      </div>
    </div>
    <% } %>
  </div>

  <script src="/js/social-menu.js"></script>
  <script src="/js/auto-login-badge.js"></script>
  <script src="/js/lightbox.js"></script>
  <script src="/js/admin.js"></script>

</body>
</html>
