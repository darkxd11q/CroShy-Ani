<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Giriş Yap — CroShy Anı</title>
<link rel="icon" type="image/png" sizes="32x32" href="/img/logo-64.png" />
<link rel="apple-touch-icon" href="/img/logo-192.png" />
<script>(function(){var m=document.cookie.match(/(?:^|; )croshy_theme=([^;]+)/);if(m&&/^[a-z]+$/.test(m[1]))document.documentElement.classList.add('theme-'+m[1]);})();</script>
<link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="bg-blobs">
    <div class="blob b1"></div>
    <div class="blob b2"></div>
  </div>
  <div class="auth-page">
    <div class="auth-page-inner">
      <%- include('partials/auth-card', { tab: 'login', error: locals.error || null, next: locals.next || '' }) %>
      <p class="auth-back"><a href="/">← Ana sayfaya dön</a></p>
    </div>
  </div>
  <script src="/js/auth-card.js"></script>
  <script src="/js/cookie-banner.js"></script>
</body>
</html>
