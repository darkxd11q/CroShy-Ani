<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Profilim — CroShy Anı</title>
<link rel="icon" type="image/png" sizes="32x32" href="/img/logo-64.png" />
<link rel="apple-touch-icon" href="/img/logo-192.png" />
<link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <div class="bg-blobs">
    <div class="blob b1"></div>
    <div class="blob b2"></div>
    <div class="blob b3"></div>
  </div>

  <header class="site">
    <a href="/" class="brand"><span class="brand-mark-wrap"><img src="/img/logo-192.png" alt="CroShy Anı logosu" /></span><span class="brand-text">CroShy Anı</span></a>
    <nav class="site-nav">
      <div class="social-dropdown" id="socialDropdown">
        <button type="button" class="yt-link social-trigger" aria-label="Bağlantılar" aria-haspopup="true" aria-expanded="false">
          <svg viewBox="0 0 24 24" width="19" height="19" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M9.5 14.5 14.5 9.5" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M11 6.5 12.7 4.8a3.2 3.2 0 0 1 4.5 4.5L15.5 11" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M13 17.5 11.3 19.2a3.2 3.2 0 0 1-4.5-4.5L8.5 13" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="social-menu">
          <a href="https://youtube.com/CroShy" target="_blank" rel="noopener" class="social-menu-item">
            <svg class="social-icon" viewBox="0 0 28 28" xmlns="http://www.w3.org/2000/svg">
              <rect width="28" height="28" rx="7" fill="#FF0000"/>
              <path d="M11.5 9.4L19.6 14L11.5 18.6V9.4Z" fill="white"/>
            </svg>
            YouTube
          </a>
          <a href="https://discord.gg/Vp8JcCynZF" target="_blank" rel="noopener" class="social-menu-item">
            <img class="social-icon" src="/img/social-discord.png" alt="" />
            Discord
          </a>
          <a href="https://kick.com/croshy" target="_blank" rel="noopener" class="social-menu-item">
            <img class="social-icon" src="/img/social-kick.png" alt="" />
            Kick
          </a>
          <a href="https://twitch.tv/croshyy" target="_blank" rel="noopener" class="social-menu-item">
            <img class="social-icon" src="/img/social-twitch.png" alt="" />
            Twitch
          </a>
          <a href="https://bynogame.com/destekle/croshy" target="_blank" rel="noopener" class="social-menu-item">
            <img class="social-icon wordmark" src="/img/social-bynogame.png" alt="" />
            Bağış Yap
          </a>
        </div>
      </div>
      <a href="/upload" class="btn small">Anı Ekle</a>
      <form method="POST" action="/logout" style="margin:0;">
        <button type="submit" class="btn small">Çıkış Yap</button>
      </form>
      <a href="/" class="btn ghost">← Ana Sayfa</a>
    </nav>
  </header>

  <div class="upload-wrap">
    <span class="eyebrow">Hesabım</span>
    <h1 style="margin: 14px 0 24px; font-size: 1.8rem;">Profilim</h1>

    <% if (error) { %>
      <div class="login-error" style="margin-bottom:16px;"><%= error %></div>
    <% } %>
    <% if (success) { %>
      <div class="status-msg show ok" style="margin-bottom:16px;"><%= success %></div>
    <% } %>

    <div class="upload-card" style="margin-bottom: 20px;">
      <div style="display:flex; align-items:center; justify-content:space-between; gap:14px; margin-bottom: 18px; flex-wrap:wrap;">
        <div style="display:flex; align-items:center; gap:14px;">
          <div class="brand-mark-wrap" style="width:52px; height:52px;">
            <div style="width:100%; height:100%; border-radius:9px; background:linear-gradient(135deg, var(--accent-1), var(--accent-2)); display:flex; align-items:center; justify-content:center; font-family:var(--font-head); font-weight:700; font-size:1.4rem; color:#fff;">
              <%= username.charAt(0).toUpperCase() %>
            </div>
          </div>
          <div>
            <div style="font-family:var(--font-head); font-weight:700; font-size:1.25rem;"><%= username %></div>
            <div style="color:var(--text-dim); font-size:0.85rem;">
              <% if (createdAt) { %>Katılma: <%= new Date(createdAt).toLocaleDateString('tr-TR') %><% } %>
            </div>
          </div>
        </div>
        <a href="/u/<%= username %>" class="btn ghost small">Herkese Açık Halini Gör ↗</a>
      </div>

      <form method="POST" action="/profile/update-bio" style="margin-bottom: 20px;">
        <div class="field" style="margin:0;">
          <label for="bio">Hakkımda (herkese açık profilinde görünür)</label>
          <textarea id="bio" name="bio" maxlength="160" placeholder="Kendinle ilgili birkaç kelime…" style="min-height:60px;"><%= bio %></textarea>
        </div>
        <button type="submit" class="btn small" style="margin-top:10px;">Kaydet</button>
      </form>

      <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap: 12px;">
        <div style="text-align:center; background:rgba(255,255,255,0.04); border:1px solid var(--card-border); border-radius:12px; padding:14px 8px;">
          <div style="font-family:var(--font-head); font-weight:700; font-size:1.5rem;"><%= approvedCount %></div>
          <div style="color:var(--text-dim); font-size:0.78rem;">Onaylı Anı</div>
        </div>
        <div style="text-align:center; background:rgba(255,255,255,0.04); border:1px solid var(--card-border); border-radius:12px; padding:14px 8px;">
          <div style="font-family:var(--font-head); font-weight:700; font-size:1.5rem;"><%= pendingCount %></div>
          <div style="color:var(--text-dim); font-size:0.78rem;">Onay Bekleyen</div>
        </div>
        <div style="text-align:center; background:rgba(255,255,255,0.04); border:1px solid var(--card-border); border-radius:12px; padding:14px 8px;">
          <div style="font-family:var(--font-head); font-weight:700; font-size:1.5rem;"><%= totalLikes %></div>
          <div style="color:var(--text-dim); font-size:0.78rem;">Toplam Beğeni</div>
        </div>
      </div>
    </div>

    <div class="upload-card" style="margin-bottom: 20px;">
      <h2 style="margin:0 0 4px; font-size:1.05rem;">Yükleme Sınırların</h2>
      <p style="color:var(--text-dim); font-size:0.85rem; margin-bottom: 14px;">
        <% if (hasCustomLimits) { %>Admin tarafından senin için özel olarak ayarlanmış.<% } else { %>Site genelindeki varsayılan sınırlar geçerli.<% } %>
      </p>
      <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap: 10px; font-size:0.85rem;">
        <div>📷 Fotoğraf: <strong><%= (limits.imageBytes / (1024*1024)).toFixed(1) %> MB</strong></div>
        <div>🎬 Video: <strong><%= (limits.videoBytes / (1024*1024)).toFixed(1) %> MB</strong></div>
        <div>⏱️ Video süresi: <strong><%= Math.floor(limits.videoDurationSec/60) %>:<%= String(limits.videoDurationSec%60).padStart(2,'0') %></strong></div>
      </div>
    </div>

    <div class="upload-card" style="margin-bottom: 20px;">
      <h2 style="margin:0 0 14px; font-size:1.05rem;">Anıların (<%= items.length %>)</h2>
      <% if (items.length === 0) { %>
        <div class="empty-state">Henüz bir anı göndermedin.</div>
      <% } else { %>
        <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 12px;">
          <% items.forEach(function(item) { %>
            <div style="position:relative; border-radius:12px; overflow:hidden; border:1px solid var(--card-border); aspect-ratio:1;">
              <% if (item.type === 'video') { %>
                <video src="<%= item.url %>" muted loop autoplay playsinline style="width:100%; height:100%; object-fit:cover;"></video>
              <% } else { %>
                <img src="<%= item.url %>" alt="" style="width:100%; height:100%; object-fit:cover;" />
              <% } %>
              <span style="position:absolute; top:6px; left:6px; background:rgba(0,0,0,0.55); color:#fff; font-size:0.65rem; padding:3px 7px; border-radius:999px;">
                <%= item.status === 'approved' ? '✓ Onaylı' : '⏳ Bekliyor' %>
              </span>
              <span style="position:absolute; bottom:6px; left:6px; background:rgba(0,0,0,0.55); color:#fff; font-size:0.65rem; padding:3px 7px; border-radius:999px;">❤️ <%= item.likes %></span>
              <form method="POST" action="/profile/delete/<%= item.id %>" onsubmit="return confirm('Bu anıyı silmek istediğine emin misin? Bu işlem geri alınamaz.');" style="position:absolute; top:6px; right:6px;">
                <button type="submit" style="width:26px; height:26px; border-radius:50%; border:none; background:rgba(0,0,0,0.6); color:#fda4af; font-size:0.85rem; cursor:pointer;">✕</button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="upload-card">
      <h2 style="margin:0 0 14px; font-size:1.05rem;">Şifreni Değiştir</h2>
      <form method="POST" action="/profile/change-password">
        <div class="field">
          <label for="currentPassword">Mevcut şifre</label>
          <input type="password" id="currentPassword" name="currentPassword" autocomplete="current-password" required
                 style="width:100%; background: rgba(255,255,255,0.04); border:1px solid var(--card-border); border-radius:12px; padding:12px 14px; color: var(--text); font-family: var(--font-body); font-size:0.95rem;" />
        </div>
        <div class="field">
          <label for="newPassword">Yeni şifre (en az 6 karakter)</label>
          <input type="password" id="newPassword" name="newPassword" autocomplete="new-password" minlength="6" required
                 style="width:100%; background: rgba(255,255,255,0.04); border:1px solid var(--card-border); border-radius:12px; padding:12px 14px; color: var(--text); font-family: var(--font-body); font-size:0.95rem;" />
        </div>
        <div class="field">
          <label for="confirmNewPassword">Yeni şifre (tekrar)</label>
          <input type="password" id="confirmNewPassword" name="confirmNewPassword" autocomplete="new-password" minlength="6" required
                 style="width:100%; background: rgba(255,255,255,0.04); border:1px solid var(--card-border); border-radius:12px; padding:12px 14px; color: var(--text); font-family: var(--font-body); font-size:0.95rem;" />
        </div>
        <button type="submit" class="btn primary" style="width:100%; justify-content:center;">Şifreyi Güncelle</button>
      </form>
    </div>
  </div>

  <footer class="site">CroShy Anı · Bu sayfa ileride daha da geliştirilecek</footer>

  <script src="/js/social-menu.js"></script>
  <script src="/js/auto-login-badge.js"></script>
</body>
</html>
