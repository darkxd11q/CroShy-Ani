<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Profilim — CroShy Anı</title>
<link rel="icon" type="image/png" sizes="32x32" href="/img/logo-64.png" />
<link rel="apple-touch-icon" href="/img/logo-192.png" />
<link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <div class="bg-blobs">
    <div class="blob b1"></div>
    <div class="blob b2"></div>
    <div class="blob b3"></div>
  </div>

  <header class="site">
    <a href="/" class="brand"><span class="brand-mark-wrap"><img src="/img/logo-192.png" alt="CroShy Anı logosu" /></span><span class="brand-text">CroShy Anı</span></a>
    <nav class="site-nav">
      <div class="social-dropdown" id="socialDropdown">
        <button type="button" class="yt-link social-trigger" aria-label="Bağlantılar" aria-haspopup="true" aria-expanded="false">
          <svg viewBox="0 0 24 24" width="19" height="19" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M9.5 14.5 14.5 9.5" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M11 6.5 12.7 4.8a3.2 3.2 0 0 1 4.5 4.5L15.5 11" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M13 17.5 11.3 19.2a3.2 3.2 0 0 1-4.5-4.5L8.5 13" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="social-menu">
          <a href="https://youtube.com/CroShy" target="_blank" rel="noopener" class="social-menu-item">
            <svg class="social-icon" viewBox="0 0 28 28" xmlns="http://www.w3.org/2000/svg">
              <rect width="28" height="28" rx="7" fill="#FF0000"/>
              <path d="M11.5 9.4L19.6 14L11.5 18.6V9.4Z" fill="white"/>
            </svg>
            YouTube
          </a>
          <a href="https://discord.gg/Vp8JcCynZF" target="_blank" rel="noopener" class="social-menu-item">
            <img class="social-icon" src="/img/social-discord.png" alt="" />
            Discord
          </a>
          <a href="https://kick.com/croshy" target="_blank" rel="noopener" class="social-menu-item">
            <img class="social-icon" src="/img/social-kick.png" alt="" />
            Kick
          </a>
          <a href="https://twitch.tv/croshyy" target="_blank" rel="noopener" class="social-menu-item">
            <img class="social-icon" src="/img/social-twitch.png" alt="" />
            Twitch
          </a>
          <a href="https://bynogame.com/destekle/croshy" target="_blank" rel="noopener" class="social-menu-item">
            <img class="social-icon wordmark" src="/img/social-bynogame.png" alt="" />
            Bağış Yap
          </a>
        </div>
      </div>
      <a href="/upload" class="btn small">Anı Ekle</a>
      <form method="POST" action="/logout" style="margin:0;">
        <button type="submit" class="btn small">Çıkış Yap</button>
      </form>
      <a href="/" class="btn ghost">← Ana Sayfa</a>
    </nav>
  </header>

  <div class="upload-wrap" style="max-width: 720px;">
    <span class="eyebrow">Hesabım</span>

    <% if (error) { %>
      <div class="login-error" style="margin: 14px 0;"><%= error %></div>
    <% } %>
    <% if (success) { %>
      <div class="status-msg show ok" style="margin: 14px 0;"><%= success %></div>
    <% } %>

    <div class="upload-card" style="margin: 18px 0 20px;">
      <div class="profile-hero">
        <div class="profile-avatar"><%= username.charAt(0).toUpperCase() %></div>
        <div class="profile-identity">
          <div class="profile-name-row">
            <span class="profile-name"><%= username %></span>
          </div>
          <% if (badges && badges.length > 0) { %>
            <div class="badge-row">
              <% BADGE_ORDER.forEach(function(code) { %>
                <% if (badges.includes(code)) { %>
                  <span class="badge-pill <%= BADGE_INFO[code].className %>"><%= BADGE_INFO[code].icon %> <%= BADGE_INFO[code].label %></span>
                <% } %>
              <% }) %>
            </div>
          <% } %>
          <div class="profile-joined"><% if (createdAt) { %>Katılma: <%= new Date(createdAt).toLocaleDateString('tr-TR') %><% } %></div>
          <div class="profile-actions">
            <a href="/u/<%= encodeURIComponent(username) %>" class="btn ghost small">Herkese Açık Halini Gör ↗</a>
          </div>
        </div>
      </div>

      <form method="POST" action="/profile/update-bio" style="margin-top: 18px;">
        <div class="field" style="margin:0;">
          <label for="bio">Hakkımda (herkese açık profilinde görünür)</label>
          <textarea id="bio" name="bio" maxlength="160" placeholder="Kendinle ilgili birkaç kelime…" style="min-height:60px;"><%= bio %></textarea>
        </div>
        <button type="submit" class="btn small" style="margin-top:10px;">Kaydet</button>
      </form>

      <div class="profile-stats-grid" style="margin-top: 20px;">
        <div class="profile-stat-card">
          <div class="profile-stat-value"><%= approvedCount %></div>
          <div class="profile-stat-label">Onaylı Anı</div>
        </div>
        <div class="profile-stat-card">
          <div class="profile-stat-value"><%= pendingCount %></div>
          <div class="profile-stat-label">Onay Bekleyen</div>
        </div>
        <div class="profile-stat-card">
          <div class="profile-stat-value"><%= totalLikes %></div>
          <div class="profile-stat-label">Toplam Beğeni</div>
        </div>
      </div>
    </div>

    <% if (limits.unlimited) { %>
      <div class="unlimited-banner">
        <span class="icon">✨</span>
        <span>Rozetin sayesinde hiçbir dosya boyutu, video süresi ya da günlük gönderim sınırına takılmıyorsun.</span>
      </div>
    <% } else { %>
      <div class="upload-card" style="margin-bottom: 20px;">
        <h2 class="profile-section-title">📏 Yükleme Sınırların</h2>
        <p class="profile-section-sub">
          <% if (hasCustomLimits) { %>Admin tarafından senin için özel olarak ayarlanmış.<% } else { %>Site genelindeki varsayılan sınırlar geçerli.<% } %>
        </p>
        <div class="profile-limits-grid">
          <div class="profile-limit-item">📷 Fotoğraf: <strong><%= (limits.imageBytes / (1024*1024)).toFixed(1) %> MB</strong></div>
          <div class="profile-limit-item">🎬 Video: <strong><%= (limits.videoBytes / (1024*1024)).toFixed(1) %> MB</strong></div>
          <div class="profile-limit-item">⏱️ Video süresi: <strong><%= Math.floor(limits.videoDurationSec/60) %>:<%= String(limits.videoDurationSec%60).padStart(2,'0') %></strong></div>
        </div>
      </div>
    <% } %>

    <div class="upload-card" style="margin-bottom: 20px;">
      <h2 class="profile-section-title">🖼️ Anıların (<%= items.length %>)</h2>
      <% if (items.length === 0) { %>
        <div class="empty-state">Henüz bir anı göndermedin.</div>
      <% } else { %>
        <div class="profile-grid">
          <% items.forEach(function(item) { %>
            <div class="profile-item-card">
              <% if (item.type === 'video') { %>
                <video src="<%= item.url %>" muted loop autoplay playsinline></video>
              <% } else { %>
                <img src="<%= item.url %>" alt="" />
              <% } %>
              <span class="profile-item-status <%= item.status === 'approved' ? 'is-approved' : 'is-pending' %>">
                <%= item.status === 'approved' ? '✓ Onaylı' : '⏳ Bekliyor' %>
              </span>
              <span class="profile-item-likes">❤️ <%= item.likes %></span>
              <form method="POST" action="/profile/delete/<%= item.id %>" onsubmit="return confirm('Bu anıyı silmek istediğine emin misin? Bu işlem geri alınamaz.');" style="position:absolute; top:6px; right:6px; margin:0;">
                <button type="submit" class="profile-item-delete" aria-label="Sil">✕</button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="upload-card">
      <h2 class="profile-section-title">🔒 Şifreni Değiştir</h2>
      <form method="POST" action="/profile/change-password">
        <div class="field">
          <label for="currentPassword">Mevcut şifre</label>
          <input type="password" id="currentPassword" name="currentPassword" autocomplete="current-password" required
                 style="width:100%; background: rgba(255,255,255,0.04); border:1px solid var(--card-border); border-radius:12px; padding:12px 14px; color: var(--text); font-family: var(--font-body); font-size:0.95rem;" />
        </div>
        <div class="field">
          <label for="newPassword">Yeni şifre (en az 6 karakter)</label>
          <input type="password" id="newPassword" name="newPassword" autocomplete="new-password" minlength="6" required
                 style="width:100%; background: rgba(255,255,255,0.04); border:1px solid var(--card-border); border-radius:12px; padding:12px 14px; color: var(--text); font-family: var(--font-body); font-size:0.95rem;" />
        </div>
        <div class="field">
          <label for="confirmNewPassword">Yeni şifre (tekrar)</label>
          <input type="password" id="confirmNewPassword" name="confirmNewPassword" autocomplete="new-password" minlength="6" required
                 style="width:100%; background: rgba(255,255,255,0.04); border:1px solid var(--card-border); border-radius:12px; padding:12px 14px; color: var(--text); font-family: var(--font-body); font-size:0.95rem;" />
        </div>
        <button type="submit" class="btn primary" style="width:100%; justify-content:center;">Şifreyi Güncelle</button>
      </form>
    </div>
  </div>

  <footer class="site">CroShy Anı · Bu sayfa ileride daha da geliştirilecek</footer>

  <script src="/js/social-menu.js"></script>
  <script src="/js/auto-login-badge.js"></script>
</body>
</html>
