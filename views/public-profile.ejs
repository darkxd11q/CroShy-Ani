<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= profileUsername %> — CroShy Anı</title>
<link rel="icon" type="image/png" sizes="32x32" href="/img/logo-64.png" />
<link rel="apple-touch-icon" href="/img/logo-192.png" />
<link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <div class="bg-blobs">
    <div class="blob b1"></div>
    <div class="blob b2"></div>
    <div class="blob b3"></div>
  </div>

  <header class="site">
    <a href="/" class="brand"><span class="brand-mark-wrap"><img src="/img/logo-192.png" alt="CroShy Anı logosu" /></span><span class="brand-text">CroShy Anı</span></a>
    <nav class="site-nav">
      <div class="social-dropdown" id="socialDropdown">
        <button type="button" class="yt-link social-trigger" aria-label="Bağlantılar" aria-haspopup="true" aria-expanded="false">
          <svg viewBox="0 0 24 24" width="19" height="19" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M9.5 14.5 14.5 9.5" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M11 6.5 12.7 4.8a3.2 3.2 0 0 1 4.5 4.5L15.5 11" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M13 17.5 11.3 19.2a3.2 3.2 0 0 1-4.5-4.5L8.5 13" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="social-menu">
          <a href="https://youtube.com/CroShy" target="_blank" rel="noopener" class="social-menu-item">
            <svg class="social-icon" viewBox="0 0 28 28" xmlns="http://www.w3.org/2000/svg">
              <rect width="28" height="28" rx="7" fill="#FF0000"/>
              <path d="M11.5 9.4L19.6 14L11.5 18.6V9.4Z" fill="white"/>
            </svg>
            YouTube
          </a>
          <a href="https://discord.gg/Vp8JcCynZF" target="_blank" rel="noopener" class="social-menu-item">
            <img class="social-icon" src="/img/social-discord.png" alt="" />
            Discord
          </a>
          <a href="https://kick.com/croshy" target="_blank" rel="noopener" class="social-menu-item">
            <img class="social-icon" src="/img/social-kick.png" alt="" />
            Kick
          </a>
          <a href="https://twitch.tv/croshyy" target="_blank" rel="noopener" class="social-menu-item">
            <img class="social-icon" src="/img/social-twitch.png" alt="" />
            Twitch
          </a>
          <a href="https://bynogame.com/destekle/croshy" target="_blank" rel="noopener" class="social-menu-item">
            <img class="social-icon wordmark" src="/img/social-bynogame.png" alt="" />
            Bağış Yap
          </a>
        </div>
      </div>
      <% if (isOwnProfile) { %>
        <a href="/profile" class="btn small">Profilimi Düzenle</a>
      <% } %>
      <a href="/" class="btn ghost">← Ana Sayfa</a>
    </nav>
  </header>

  <div class="upload-wrap">
    <div class="upload-card" style="margin-bottom: 20px;">
      <div style="display:flex; align-items:center; gap:14px; margin-bottom: <%= bio ? '14px' : '0' %>;">
        <div class="brand-mark-wrap" style="width:60px; height:60px;">
          <div style="width:100%; height:100%; border-radius:9px; background:linear-gradient(135deg, var(--accent-1), var(--accent-2)); display:flex; align-items:center; justify-content:center; font-family:var(--font-head); font-weight:700; font-size:1.6rem; color:#fff;">
            <%= profileUsername.charAt(0).toUpperCase() %>
          </div>
        </div>
        <div>
          <div style="font-family:var(--font-head); font-weight:700; font-size:1.4rem;"><%= profileUsername %></div>
          <div style="color:var(--text-dim); font-size:0.85rem;">
            <% if (createdAt) { %>CroShy Anı'na katıldı: <%= new Date(createdAt).toLocaleDateString('tr-TR') %><% } %>
          </div>
        </div>
      </div>
      <% if (bio) { %>
        <p style="color:var(--text); font-size:0.9rem; margin: 0; padding-top:14px; border-top:1px solid var(--card-border);"><%= bio %></p>
      <% } %>

      <div style="display:grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 18px;">
        <div style="text-align:center; background:rgba(255,255,255,0.04); border:1px solid var(--card-border); border-radius:12px; padding:14px 8px;">
          <div style="font-family:var(--font-head); font-weight:700; font-size:1.5rem;"><%= approvedCount %></div>
          <div style="color:var(--text-dim); font-size:0.78rem;">Paylaşılan Anı</div>
        </div>
        <div style="text-align:center; background:rgba(255,255,255,0.04); border:1px solid var(--card-border); border-radius:12px; padding:14px 8px;">
          <div style="font-family:var(--font-head); font-weight:700; font-size:1.5rem;"><%= totalLikes %></div>
          <div style="color:var(--text-dim); font-size:0.78rem;">Toplam Beğeni</div>
        </div>
      </div>
    </div>

    <h2 style="font-size:1.1rem; margin: 0 0 14px;"><%= profileUsername %>'in Anıları</h2>
    <% if (items.length === 0) { %>
      <div class="empty-state">Henüz onaylanmış bir anısı yok.</div>
    <% } else { %>
      <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 14px; margin-bottom: 40px;">
        <% items.forEach(function(item, idx) { %>
          <div class="memory-card" data-index="<%= idx %>" style="height: 220px; transform:none;">
            <% if (item.type === 'video') { %>
              <video src="<%= item.url %>" muted loop autoplay playsinline></video>
              <div class="play-icon" style="width:44px; height:44px; font-size:1rem;">▶</div>
            <% } else { %>
              <img src="<%= item.url %>" alt="" loading="lazy" />
            <% } %>
            <span class="badge"><%= item.type === 'video' ? '🎬' : '📷' %></span>
            <div class="overlay">
              <div class="meta">
                <div class="caption" style="color:#fff;"><%= item.caption %></div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <footer class="site">CroShy Anı · Herkese açık profil</footer>

  <script src="/js/social-menu.js"></script>
  <script src="/js/lightbox.js"></script>
  <script>
    const PROFILE_ITEMS = <%- JSON.stringify(items).replace(/</g, '\\u003c') %>;
    document.querySelectorAll('.memory-card').forEach((card) => {
      card.addEventListener('click', () => {
        const idx = Number(card.dataset.index);
        openLightbox(PROFILE_ITEMS[idx]);
      });
    });
  </script>
</body>
</html>
