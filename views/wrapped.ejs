<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Yıl özetim — CroShy Anı</title>
<link rel="icon" type="image/png" sizes="32x32" href="/img/logo-64.png" />
<link rel="apple-touch-icon" href="/img/logo-192.png" />
<script>(function(){var m=document.cookie.match(/(?:^|; )croshy_theme=([^;]+)/);if(m&&/^[a-z]+$/.test(m[1]))document.documentElement.classList.add('theme-'+m[1]);})();</script>
<link rel="stylesheet" href="/css/style.css" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="theme-color" content="#0b0a14" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<script src="/js/pwa.js" defer></script>
<script src="/js/whats-new.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#icerik">İçeriğe geç</a>
  <div class="bg-blobs"><div class="blob b1"></div><div class="blob b2"></div></div>

  <header class="site">
    <a href="/" class="brand"><span class="brand-mark-wrap"><img src="/img/logo-192.png" alt="CroShy Anı logosu" /></span><span class="brand-text">CroShy Anı</span></a>
    <nav class="site-nav">
      <div class="social-dropdown" id="socialDropdown">
        <button type="button" class="yt-link social-trigger" aria-label="Bağlantılar" aria-haspopup="true" aria-expanded="false">
          <svg viewBox="0 0 24 24" width="19" height="19" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M9.5 14.5 14.5 9.5" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M11 6.5 12.7 4.8a3.2 3.2 0 0 1 4.5 4.5L15.5 11" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M13 17.5 11.3 19.2a3.2 3.2 0 0 1-4.5-4.5L8.5 13" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="social-menu">
          <a href="https://youtube.com/CroShy" target="_blank" rel="noopener" class="social-menu-item">
            <svg class="social-icon" viewBox="0 0 28 28" xmlns="http://www.w3.org/2000/svg">
              <rect width="28" height="28" rx="7" fill="#FF0000"/>
              <path d="M11.5 9.4L19.6 14L11.5 18.6V9.4Z" fill="white"/>
            </svg>
            YouTube
          </a>
          <a href="https://discord.gg/Vp8JcCynZF" target="_blank" rel="noopener" class="social-menu-item">
            <img class="social-icon" src="/img/social-discord.png" alt="" />
            Discord
          </a>
          <a href="https://kick.com/croshy" target="_blank" rel="noopener" class="social-menu-item">
            <img class="social-icon" src="/img/social-kick.png" alt="" />
            Kick
          </a>
          <a href="https://twitch.tv/croshyy" target="_blank" rel="noopener" class="social-menu-item">
            <img class="social-icon" src="/img/social-twitch.png" alt="" />
            Twitch
          </a>
          <a href="https://bynogame.com/destekle/croshy" target="_blank" rel="noopener" class="social-menu-item">
            <img class="social-icon wordmark" src="/img/social-bynogame.png" alt="" />
            Bağış Yap
          </a>
        </div>
      </div>
      <a href="/upload" class="btn small">Anı Ekle</a>
      <form method="POST" action="/logout" style="margin:0;">
        <button type="submit" class="btn small">Çıkış Yap</button>
      </form>
      <a href="/" class="btn ghost">← Ana Sayfa</a>
    </nav>
  </header>

  <main class="wrapped-page" id="icerik">
    <span class="eyebrow">Yıl özeti</span>
    <h1 class="wrapped-title">🎁 <%= year %> CroShy Anı yılın</h1>
    <p class="wrapped-sub"><strong><%= username %></strong>, bu yılın hikayesi burada.</p>
    <% if (years.length > 1) { %>
      <nav class="wrapped-years" aria-label="Yıl seç"><% years.forEach(function(y) { %><a href="/yilim?yil=<%= y %>" class="<%= y === year ? 'active' : '' %>"><%= y %></a><% }) %></nav>
    <% } %>

    <% if (data.empty) { %>
      <div class="upload-card" style="margin-top:20px; text-align:center;">
        <p style="margin:0 0 14px;">Bu yıl henüz onaylanmış bir anın yok. İlk anıyı paylaş, özetin oluşsun! 🌱</p>
        <a class="btn primary" href="/upload">+ Anı Ekle</a>
      </div>
    <% } else { %>
      <div class="wrapped-grid">
        <div class="wrapped-tile"><span class="wrapped-num"><%= data.memories %></span><span class="wrapped-lbl">anı paylaştın</span><small><%= data.photos %> foto · <%= data.videos %> video</small></div>
        <div class="wrapped-tile"><span class="wrapped-num"><%= data.likes %></span><span class="wrapped-lbl">beğeni aldın</span></div>
        <div class="wrapped-tile"><span class="wrapped-num"><%= data.comments %></span><span class="wrapped-lbl">yorum aldın</span></div>
        <% if (data.reactions != null) { %><div class="wrapped-tile"><span class="wrapped-num"><%= data.reactions %></span><span class="wrapped-lbl">emoji tepkisi</span></div><% } %>
      </div>

      <% if (data.topMemory) { %>
        <section class="upload-card wrapped-top">
          <h2 class="profile-section-title">🏆 En çok beğenilen anın</h2>
          <a href="/m/<%= data.topMemory.id %>" class="wrapped-top-link">
            <img src="<%= data.topMemory.imageUrl %>" alt="<%= data.topMemory.caption || 'En çok beğenilen anın' %>" loading="lazy" />
            <span>❤️ <%= data.topMemory.likes %> beğeni<% if (data.topMemory.caption) { %> — <%= data.topMemory.caption %><% } %></span>
          </a>
        </section>
      <% } %>

      <section class="upload-card">
        <h2 class="profile-section-title">📆 En aktif ayın: <%= data.busiestMonth.name %> (<%= data.busiestMonth.count %> anı)</h2>
        <div class="wrapped-bars" role="img" aria-label="Aylara göre anı sayısı">
          <% var maxM = Math.max.apply(null, data.months) || 1; data.months.forEach(function(c, i) { %>
            <div class="wrapped-bar" title="<%= data.monthNames[i] %>: <%= c %>"><span style="height: <%= Math.round((c / maxM) * 100) %>%"></span><small><%= data.monthNames[i].slice(0, 3) %></small></div>
          <% }) %>
        </div>
      </section>

      <ul class="wrapped-facts">
        <li>🔥 Üst üste en uzun <strong><%= data.longestStreakWeeks %> hafta</strong> anı paylaştın</li>
        <% if (data.rank) { %><li>🥇 Toplulukta <strong>ilk %<%= data.rank.topPercent %></strong> içindesin (<%= data.rank.total %> kişi arasında <%= data.rank.rank %>.)</li><% } %>
        <% if (data.topTags.length) { %><li>#️⃣ En sevdiğin etiketler: <strong><%= data.topTags.map(function(t) { return '#' + t.tag; }).join(' ') %></strong></li><% } %>
        <% if (data.weeklyActive + data.weeklyLiked > 0) { %><li>🏅 Haftalık ödül: <strong><%= data.weeklyActive + data.weeklyLiked %></strong> kez kazandın</li><% } %>
      </ul>

      <section class="upload-card wrapped-share">
        <h2 class="profile-section-title">📸 Paylaşım kartı</h2>
        <p class="profile-section-sub">Hikayende / durumunda paylaşabileceğin bir kart oluştur.</p>
        <button type="button" class="btn primary" id="makeCard">Kartı oluştur</button>
        <div id="cardOut" hidden>
          <img id="cardPreview" alt="Yıl özeti paylaşım kartı" />
          <div class="recovery-actions" style="margin-top:12px;">
            <button type="button" class="btn small" id="shareCard" hidden>📤 Paylaş</button>
            <button type="button" class="btn small" id="downloadCard">⬇️ İndir</button>
          </div>
        </div>
      </section>
    <% } %>
    <script type="application/json" id="wrappedData"><%- JSON.stringify({ year: year, username: username, data: data, host: host }).replace(/</g, '\\u003c') %></script>
  </main>

  <footer class="site">CroShy Anı</footer>
  <script src="/js/social-menu.js"></script>
  <script src="/js/auth-nav.js"></script>
  <script src="/js/feedback-widget.js"></script>
  <script src="/js/cookie-banner.js"></script>
  <script src="/js/wrapped.js"></script>
</body>
</html>
